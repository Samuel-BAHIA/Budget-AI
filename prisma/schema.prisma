generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use DATABASE_URL from the environment (.env.local in dev)
  url      = env("DATABASE_URL")
}

// Minimal per-user persistent storage.
// We use session.user.id (mapped to email in NextAuth callbacks) as the key.
model BudgetState {
  userId    String   @id
  dataJson  Json
  updatedAt DateTime @updatedAt
}
