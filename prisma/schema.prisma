generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL moved to prisma.config.ts
}

// Minimal per-user persistent storage.
// We use session.user.id (mapped to email in NextAuth callbacks) as the key.
model BudgetState {
  userId    String   @id
  dataJson  Json
  updatedAt DateTime @updatedAt
}