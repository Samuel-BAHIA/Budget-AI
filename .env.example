# --- Neon Postgres (connection pooling recommended on Vercel) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require&channel_binding=require"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"  # base URL only (no /api/auth/...)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Google OAuth
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Facebook OAuth
FACEBOOK_CLIENT_ID="..."
FACEBOOK_CLIENT_SECRET="..."
